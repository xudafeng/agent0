LLM_PROVIDER='kimi'

OPENAI_API_KEY='your-openai-api-key'
OPENAI_MODEL='gpt-5.5'

MOONSHOT_API_KEY='your-kimi-api-key'
MOONSHOT_BASE_URL='https://api.moonshot.cn/v1'
MOONSHOT_MODEL='kimi-k2.6'

# Managed by the desktop MCP settings panel: base64-encoded JSON, not encryption.
MCP_SERVERS_BASE64=

# Optional Jev tool routing. Disabled until explicitly enabled.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_CONFIDENCE=0.8
JEV_TIMEOUT_MS=3000

# Optional JSON array of absolute skill directories; [] disables skills.
# Default: ~/.agents/skills and .agents/skills in the configuration directory.
AGENT0_SKILL_DIRS=
