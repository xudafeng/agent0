{
  "name": "agent0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI agent runtime with tool calling, MCP integration, persistent memory, and task planning.",
  "scripts": {
    "start": "pnpm build && electron .",
    "cli": "tsx src/index.ts",
    "eval": "tsx src/eval.ts",
    "test": "node --import tsx --test tests/*.test.ts src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:icons": "electron scripts/build-icons.mjs",
    "package": "pnpm build && electron-builder --mac dir",
    "test:desktop": "pnpm build && electron tests/desktop-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "dotenv": "^17.2.2",
    "openai": "^7.15.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "com.xudafeng.agent0",
    "productName": "agent0",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*.js",
      "desktop/**",
      "web/**",
      "package.json"
    ],
    "mac": {
      "icon": "desktop/assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null
    }
  }
}
